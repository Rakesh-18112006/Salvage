GROQ_API_KEY=
# Optional extra links in the provider fallback chain.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=postgres://salvage:salvage@localhost:55432/salvage
REDIS_URL=redis://localhost:56379
RAZORPAY_WEBHOOK_SECRET=simulated_local_webhook_secret_do_not_use_in_prod
